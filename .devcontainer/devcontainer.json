{
  "name": "inventory-forecasting",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -e \".[dev]\" && invforecast train data/sample_sales.csv --model ensemble --out models/model.joblib",
  "postStartCommand": "nohup python -m uvicorn invforecast.api:app --host 0.0.0.0 --port 8000 > /tmp/api.log 2>&1 &",
  "containerEnv": {
    "INVFORECAST_MODEL_PATH": "models/model.joblib"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "API docs (/docs)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
